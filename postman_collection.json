                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeNumber\": \"12\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/management/users/{{userId}}/employee-number",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "users",
                "{{userId}}",
                "employee-number"
              ]
            }
          },
          "response": []
        }
