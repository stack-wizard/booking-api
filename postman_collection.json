{
  "info": {
    "name": "Booking API - Quick Requests",
    "_postman_id": "5d3f1b2a-0000-4000-8000-000000000001",
    "description": "Sample requests for booking-api. Set collection variable jwt to a Mikos Platform access token (user JWT or m2m with scope booking.api). Send X-Tenant-Id = platform tenant UUID.",
